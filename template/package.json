{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{DISPLAY_NAME}}",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint --max-warnings=0 .",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:styles": "stylelint --max-warnings=0 \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:storybook": "storybook build",
    "test:visual": "playwright test --project=visual",
    "test:e2e": "playwright test --project=e2e",
    "verify:feature-guide": "tsc -p quality-fixtures/feature-guide/tsconfig.json --noEmit && node scripts/check-boundaries.mjs --root quality-fixtures/feature-guide/src && vitest run --config quality-fixtures/feature-guide/vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check && npm test"
  },
  "dependencies": {
    "@salt-ds/core": "1.72.0",
    "@salt-ds/icons": "1.18.3",
    "@salt-ds/theme": "1.47.0",
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "knip": "6.38.0",
    "msw": "3.0.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "stylelint": "17.15.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}